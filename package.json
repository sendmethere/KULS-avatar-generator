{
  "name": "kuls-avatar-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "test": "node tests/smoke.mjs",
    "test:classroom": "node tests/classroom.mjs",
    "test:details": "node tests/garment-details.mjs",
    "test:refinements": "node tests/studio-refinements.mjs",
    "setup": "npm ci && npm run build",
    "test:geometry": "node tests/geometry.mjs && node tests/skirt-clearance.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "three": "^0.180.0",
    "vite": "^7.1.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "gltf-validator": "^2.0.0-dev.3.10"
  },
  "description": "Local customizable 3D avatar studio with Blender and Unity exports",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
